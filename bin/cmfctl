#!/usr/bin/env python3
"""Entry point for cmfctl. The command itself lives in cmfctl.cli.

This file is deliberately thin, because it is the one that gets symlinked:
`install.sh` points ~/.local/bin/cmfctl here, so at run time __file__ is the
symlink, not this file. Only realpath() resolves it back to the checkout that
holds src/ -- without it the import below fails for every installed user while
continuing to work in the repo, which is the least helpful way for it to break.
"""
import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))

from cmfctl.cli import main  # noqa: E402  (path must be set before the import)

if __name__ == "__main__":
    main()
